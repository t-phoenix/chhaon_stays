# Copy to .env and fill in real values. Never commit .env.

# MongoDB — local Docker or MongoDB Atlas connection string
MONGO_URL=mongodb://localhost:27017
DB_NAME=chhaon_cafe_ops

# Auth
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false
COOKIE_NAME=chhaon_access

# Comma-separated frontend origins (no trailing slash)
CORS_ORIGINS=http://localhost:3000

# Seeded admin account (created on first startup)
ADMIN_MOBILE=9625005516
ADMIN_PASSWORD=change-me
ADMIN_NAME=Amrit

# Optional — default staff passcode for seeded test staff
# STAFF_PASSCODE=1234

# Optional — default mesh PIN shown on Team page
# MESH_PIN=cafe1
